{
  "name": "@news-draft/db",
  "private": true,
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -w -p tsconfig.build.json --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:apply": "tsx src/migrate.ts",
    "db:studio": "drizzle-kit studio --host=127.0.0.1"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
