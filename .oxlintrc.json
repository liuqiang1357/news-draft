{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/drizzle/**",
    "**/next-env.d.ts"
  ],
  "options": {
    "maxWarnings": 0
  },
  "rules": {
    "typescript/consistent-type-imports": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
